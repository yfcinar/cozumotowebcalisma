{% extends 'layout.twig' %}
{% block title %}Hizmetlerimiz | {{ site.brand_name|default('Çözüm Oto Elektrik') }}{% endblock %}
{% block description %}Renault EDC şanzıman, beyin onarımı, kavrama, DW5 otomatik şanzıman, AdBlue, EGR ve partikül filtre temizliği hizmetlerimiz.{% endblock %}

{% block content %}
<div class="page-header page-header-small page-head">
    <div class="container">
        <nav class="breadcrumb-line"><a href="/">Anasayfa</a> <i class="fa fa-angle-right"></i> <span>Hizmetler</span></nav>
        <h1>Hizmetlerimiz</h1>
        <p>Renault ve uyumlu modellerde elektronik ve mekanik arızalara profesyonel çözümler.</p>
    </div>
</div>

<div class="section">
    <div class="container">
        <div class="row">
            {% for s in services %}
            <div class="col-md-6 col-lg-4 d-flex">
                <a class="card card-service" href="/hizmet/{{ s.slug }}">
                    <div class="card-body">
                        <div class="card-service__icon">{{ s.icon|default('🔧') }}</div>
                        <h3 class="card-title">{{ s.title }}</h3>
                        <p class="card-description">{{ s.summary|default(s.body|excerpt(120)) }}</p>
                        <span class="card-service__more">Detaylar <i class="fa fa-long-arrow-right"></i></span>
                    </div>
                </a>
            </div>
            {% endfor %}
        </div>
    </div>
</div>
{% endblock %}
