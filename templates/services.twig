{% extends 'layout.twig' %}
{% block title %}Hizmetlerimiz | {{ site.brand_name|default('Çözüm Oto Elektrik') }}{% endblock %}
{% block description %}Renault EDC şanzıman, beyin onarımı, kavrama, DW5 otomatik şanzıman, AdBlue, EGR ve partikül filtre temizliği hizmetlerimiz.{% endblock %}

{% block content %}
<div class="page-header page-head" style="background-image: url('/assets/img/head-tools.jpg');">
    <div class="filter"></div>
    <div class="container">
        <div class="motto">
            <nav class="breadcrumb-line"><a href="/">Anasayfa</a> <i class="fa fa-angle-right"></i> <span>Hizmetler</span></nav>
            <h1>Hizmetlerimiz</h1>
            <p>Renault ve uyumlu modellerde elektronik ve mekanik arızalara profesyonel çözümler.</p>
        </div>
    </div>
</div>

<div class="section text-center">
    <div class="container">
        <div class="row">
            {% for s in services %}
            <div class="col-md-4 col-sm-6">
                <div class="info">
                    <div class="icon icon-danger">
                        <i class="fa {{ s.icon starts with 'fa-' ? s.icon : 'fa-wrench' }}" aria-hidden="true"></i>
                    </div>
                    <div class="description">
                        <h4 class="info-title">{{ s.title }}</h4>
                        <p class="description">{{ s.summary|default(s.body|excerpt(110)) }}</p>
                        <a href="/hizmet/{{ s.slug }}" class="btn btn-link btn-danger">Detaylar</a>
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
</div>
{% endblock %}
