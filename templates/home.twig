{% extends 'layout.twig' %}

{% block title %}{{ site.site_title|default('Çözüm Oto Elektrik — Renault EDC Şanzıman & Elektronik Servisi') }}{% endblock %}

{% block content %}
<div class="page-header" data-parallax="true" style="background-image: url('/assets/img/hero-engine.jpg');">
    <div class="filter"></div>
    <div class="container">
        <div class="motto text-center">
            <h1>{{ site.hero_title|default('Renault EDC Şanzıman ve Oto Elektronik Çözüm Merkezi') }}</h1>
            <h3>{{ site.hero_subtitle|default('EDC şanzıman, beyin onarımı, kavrama, EGR ve partikül filtre temizliğinde garantili işçilik. Aracınız aynı gün içinde teslim edilir.') }}</h3>
            <br/>
            {% if site.whatsapp %}<a href="{{ whatsapp_link('Merhaba, arıza tespiti için bilgi almak istiyorum.') }}" target="_blank" rel="noopener" class="btn btn-outline-neutral btn-round"><i class="fa fa-whatsapp"></i> WhatsApp'tan Yaz</a>{% endif %}
            {% if site.phone_primary %}<a href="{{ tel_link(site.phone_primary) }}" class="btn btn-outline-neutral btn-round"><i class="fa fa-phone"></i> {{ site.phone_primary }}</a>{% endif %}
        </div>
    </div>
</div>

<div class="main">
    <div class="section text-center">
        <div class="container">
            <div class="row">
                <div class="col-md-8 ml-auto mr-auto">
                    <h2 class="title">Hizmetlerimiz</h2>
                    <h5 class="description">Renault ve uyumlu modellerde EDC şanzıman, mekatronik beyin, kavrama ve oto elektronik arızalarına uçtan uca, garantili çözümler sunuyoruz.</h5>
                    <br/>
                    <a href="/hizmetler" class="btn btn-danger btn-round">Tüm Hizmetler</a>
                </div>
            </div>
            <br/>
            <br/>
            <div class="row">
                {% for s in services|slice(0, 8) %}
                <div class="col-md-3 col-sm-6">
                    <div class="info">
                        <div class="icon icon-danger">
                            <i class="fa {{ s.icon starts with 'fa-' ? s.icon : 'fa-wrench' }}" aria-hidden="true"></i>
                        </div>
                        <div class="description">
                            <h4 class="info-title">{{ s.title }}</h4>
                            <p class="description">{{ s.summary|default(s.body|excerpt(90)) }}</p>
                            <a href="/hizmet/{{ s.slug }}" class="btn btn-link btn-danger">Detaylar</a>
                        </div>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
    </div>

    <div class="section section-gray text-center section-pricing" id="fiyatlar">
        <div class="container">
            <div class="row">
                <div class="col-md-8 ml-auto mr-auto">
                    <h2 class="title">Fiyat Listesi</h2>
                    <h5 class="description">Güncel başlangıç fiyatlarımız. Kesin fiyat, aracınızın markası/modeli ve arıza durumuna göre ücretsiz ön değerlendirme sonrası netleşir.</h5>
                </div>
            </div>
            <br/>
            <div class="row">
                {% for s in services %}
                <div class="col-md-6 col-lg-4">
                    <div class="price-card">
                        <div class="price-card__icon"><i class="fa {{ s.icon starts with 'fa-' ? s.icon : 'fa-wrench' }}" aria-hidden="true"></i></div>
                        <h4 class="price-card__title">{{ s.title }}</h4>
                        <div class="price-card__price">
                            {% if s.price %}{{ s.price }}{% else %}<span class="price-card__call">Fiyat için arayın</span>{% endif %}
                        </div>
                        <a href="/hizmet/{{ s.slug }}" class="btn btn-outline-danger btn-round btn-sm">Detaylar</a>
                    </div>
                </div>
                {% endfor %}
            </div>
            <div class="row">
                <div class="col-md-10 ml-auto mr-auto">
                    <p class="price-note">* Fiyatlara KDV dahildir ve işçilik + parça durumuna göre değişkenlik gösterebilir. Net fiyat için bizi arayın.</p>
                    <div class="price-cta">
                        {% if site.whatsapp %}<a class="btn btn-success btn-round" href="{{ whatsapp_link('Merhaba, fiyat bilgisi almak istiyorum.') }}" target="_blank" rel="noopener"><i class="fa fa-whatsapp"></i> WhatsApp'tan Fiyat Al</a>{% endif %}
                        {% if site.phone_primary %}<a class="btn btn-danger btn-round" href="{{ tel_link(site.phone_primary) }}"><i class="fa fa-phone"></i> {{ site.phone_primary }}</a>{% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="section section-dark text-center section-stats" style="background-image: url('/assets/img/dark-garage.jpg');">
        <div class="filter"></div>
        <div class="container">
            <h2 class="title">Neden {{ site.brand_name|default('Çözüm Oto Elektrik') }}?</h2>
            <div class="row">
                <div class="col-md-3 col-6"><div class="stat"><strong>10+</strong><span>Yıl Tecrübe</span></div></div>
                <div class="col-md-3 col-6"><div class="stat"><strong>5.000+</strong><span>Onarılan Araç</span></div></div>
                <div class="col-md-3 col-6"><div class="stat"><strong>%100</strong><span>Garantili İşçilik</span></div></div>
                <div class="col-md-3 col-6"><div class="stat"><strong>Aynı Gün</strong><span>Teslim</span></div></div>
            </div>
            <div class="row">
                <div class="col-md-10 ml-auto mr-auto">
                    <p class="why-line">Orijinal diagnostik ve programlama cihazları, onarım öncesi net fiyatlandırma ve tüm işlemlerde garanti. Aracınız ücretsiz ön değerlendirmenin ardından aynı gün teslim edilir.</p>
                    <a href="/iletisim" class="btn btn-danger btn-round">Randevu / Bilgi Al</a>
                </div>
            </div>
        </div>
    </div>

    {% if faqs|length %}
    <div class="section">
        <div class="container">
            <div class="row">
                <div class="col-md-8 ml-auto mr-auto text-center">
                    <h2 class="title">Sıkça Sorulan Sorular</h2>
                </div>
            </div>
            <div class="faq-acc" id="faq-accordion" role="tablist">
                {% for f in faqs %}
                <div class="card card-faq">
                    <div class="card-header" role="tab" id="faq-h{{ loop.index }}">
                        <a data-toggle="collapse" href="#faq-c{{ loop.index }}" role="button"
                           aria-expanded="false" aria-controls="faq-c{{ loop.index }}" class="collapsed">
                            {{ f.question }}
                            <i class="fa fa-angle-down"></i>
                        </a>
                    </div>
                    <div id="faq-c{{ loop.index }}" class="collapse" role="tabpanel"
                         aria-labelledby="faq-h{{ loop.index }}" data-parent="#faq-accordion">
                        <div class="card-body">{{ f.answer|nl2br }}</div>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
    </div>
    {% endif %}

    {% if gallery|length %}
    <div class="section section-gray">
        <div class="container">
            <div class="row">
                <div class="col-md-8 ml-auto mr-auto text-center">
                    <h2 class="title">Çalışmalarımızdan</h2>
                    <a href="/galeri" class="section-link">Tüm galeri <i class="fa fa-long-arrow-right"></i></a>
                </div>
            </div>
            <br/>
            <div class="masonry">
                {% for g in gallery %}
                <a class="masonry__item" href="/{{ g.file_path }}" target="_blank" rel="noopener">
                    <img src="/{{ g.file_path }}" alt="{{ g.title|default('Çalışma görseli') }}" loading="lazy">
                </a>
                {% endfor %}
            </div>
        </div>
    </div>
    {% endif %}

    <div class="section landing-section">
        <div class="container">
            <div class="row">
                <div class="col-md-8 ml-auto mr-auto">
                    <h2 class="text-center">Bize Ulaşın</h2>
                    <p class="text-center text-muted">Aracınızın arızasını kısaca anlatın, ücretsiz ön değerlendirme için sizi arayalım.</p>
                    <form class="contact-form" method="post" action="/iletisim">
                        <input type="hidden" name="_csrf" value="{{ csrf }}">
                        <input type="hidden" name="subject" value="Anasayfa Formu">
                        <div class="row">
                            <div class="col-md-6">
                                <label>Ad Soyad *</label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text"><i class="fa fa-user"></i></span>
                                    </div>
                                    <input type="text" name="name" class="form-control" placeholder="Ad Soyad" required>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label>Telefon</label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text"><i class="fa fa-phone"></i></span>
                                    </div>
                                    <input type="tel" name="phone" class="form-control" placeholder="05xx xxx xx xx">
                                </div>
                            </div>
                        </div>
                        <label>Mesajınız *</label>
                        <textarea name="message" class="form-control" rows="4" placeholder="Aracınız ve arızası hakkında kısaca bilgi verin..." required></textarea>
                        <input type="text" name="website" class="hp-field" tabindex="-1" autocomplete="off" aria-hidden="true">
                        <div class="row">
                            <div class="col-md-4 ml-auto mr-auto text-center">
                                <button type="submit" class="btn btn-danger btn-lg btn-fill">Gönder</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
