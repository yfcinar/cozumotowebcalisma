{% extends 'admin/layout.twig' %}
{% set current_nav = 'messages' %}
{% block title %}Mesaj Detayı{% endblock %}

{% block content %}
<div class="adm-pagehead">
    <div>
        <h2>{{ message.subject|default('İletişim Formu Mesajı') }}</h2>
        <p>{{ message.created_at }}</p>
    </div>
    <a class="adm-btn" href="/yonetim/mesajlar"><i class="fa fa-arrow-left"></i> Mesajlara Dön</a>
</div>

<div class="adm-grid">
    <div class="adm-card">
        <div class="adm-card__head"><h3><i class="fa fa-comment-o"></i> Mesaj İçeriği</h3></div>
        <div class="adm-card__body">
            <p style="white-space:pre-line;font-size:.95rem;line-height:1.7">{{ message.body }}</p>
        </div>
    </div>
    <div>
        <div class="adm-card">
            <div class="adm-card__head"><h3><i class="fa fa-user"></i> Gönderen</h3></div>
            <div class="adm-card__body">
                <div class="adm-field" style="gap:.9rem">
                    <div><small class="adm-muted">Ad Soyad</small><br><strong>{{ message.name }}</strong></div>
                    <div><small class="adm-muted">Telefon</small><br>{% if message.phone %}<a class="adm-link" href="{{ tel_link(message.phone) }}">{{ message.phone }}</a>{% else %}—{% endif %}</div>
                    <div><small class="adm-muted">E-posta</small><br>{% if message.email %}<a class="adm-link" href="mailto:{{ message.email }}">{{ message.email }}</a>{% else %}—{% endif %}</div>
                </div>
            </div>
        </div>
        <div class="adm-card">
            <div class="adm-card__body">
                <div class="adm-quick" style="flex-direction:column">
                    {% if message.phone %}
                    <a class="adm-btn adm-btn--primary" style="justify-content:center" href="{{ whatsapp_link('Merhaba ' ~ message.name ~ ', mesajınız için teşekkürler.') }}" target="_blank"><i class="fa fa-whatsapp"></i> WhatsApp ile Yanıtla</a>
                    <a class="adm-btn" style="justify-content:center" href="{{ tel_link(message.phone) }}"><i class="fa fa-phone"></i> Ara</a>
                    {% endif %}
                    {% if message.email %}<a class="adm-btn" style="justify-content:center" href="mailto:{{ message.email }}?subject=Re: {{ message.subject|default('İletişim') }}"><i class="fa fa-envelope"></i> E-posta Gönder</a>{% endif %}
                    <form method="post" action="/yonetim/mesajlar/{{ message.id }}/sil" data-confirm="Mesaj silinsin mi?">
                        <input type="hidden" name="_csrf" value="{{ csrf }}">
                        <button class="adm-btn adm-btn--ghost" style="width:100%;justify-content:center;color:var(--err)"><i class="fa fa-trash"></i> Mesajı Sil</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
