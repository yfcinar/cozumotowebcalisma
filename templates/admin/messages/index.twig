{% extends 'admin/layout.twig' %}
{% set current_nav = 'messages' %}
{% block title %}Mesajlar{% endblock %}

{% block content %}
<div class="adm-pagehead">
    <div>
        <h2>İletişim Mesajları</h2>
        <p>Sitedeki iletişim formundan gelen mesajları yönetin.</p>
    </div>
    <a class="adm-btn" href="/yonetim/mesajlar/disa-aktar"><i class="fa fa-download"></i> CSV İndir</a>
</div>

<div class="adm-toolbar">
    <div class="adm-tabs">
        <a href="/yonetim/mesajlar?filter=all" class="{{ filter == 'all' ? 'is-active' }}">Tümü <span class="cnt">({{ counts.all }})</span></a>
        <a href="/yonetim/mesajlar?filter=unread" class="{{ filter == 'unread' ? 'is-active' }}">Okunmamış <span class="cnt">({{ counts.unread }})</span></a>
        <a href="/yonetim/mesajlar?filter=starred" class="{{ filter == 'starred' ? 'is-active' }}">Yıldızlı <span class="cnt">({{ counts.starred }})</span></a>
    </div>
    <form class="adm-search" method="get" action="/yonetim/mesajlar">
        <i class="fa fa-search"></i>
        <input type="text" name="q" value="{{ search }}" placeholder="Ad, telefon, e-posta veya mesaj ara...">
        {% if filter != 'all' %}<input type="hidden" name="filter" value="{{ filter }}">{% endif %}
    </form>
</div>

<div class="adm-card">
    <div class="adm-card__body adm-card__body--pad0">
        <div class="adm-tablewrap">
        <table class="adm-table">
            <thead><tr><th></th><th>Durum</th><th>Gönderen</th><th>İletişim</th><th>Konu</th><th>Tarih</th><th></th></tr></thead>
            <tbody>
            {% for m in messages %}
            <tr class="{{ m.is_read ? '' : 'is-unread' }}">
                <td>
                    <form method="post" action="/yonetim/mesajlar/{{ m.id }}/yildiz">
                        <input type="hidden" name="_csrf" value="{{ csrf }}">
                        <button class="adm-iconbtn adm-iconbtn--star {{ m.is_starred ? 'is-on' }}" title="Yıldızla"><i class="fa fa-star{{ m.is_starred ? '' : '-o' }}"></i></button>
                    </form>
                </td>
                <td>{% if m.is_read %}<span class="adm-badge adm-badge--gray">Okundu</span>{% else %}<span class="adm-badge adm-badge--new">Yeni</span>{% endif %}</td>
                <td><strong>{{ m.name }}</strong></td>
                <td>{% if m.phone %}<i class="fa fa-phone adm-muted"></i> {{ m.phone }}{% endif %}{% if m.email %}<br><small class="adm-muted">{{ m.email }}</small>{% endif %}</td>
                <td>{{ m.subject|default('—') }}</td>
                <td class="adm-muted">{{ m.created_at|slice(0,16) }}</td>
                <td class="text-right">
                    <div class="adm-actions">
                        <a class="adm-iconbtn" href="/yonetim/mesajlar/{{ m.id }}" title="Aç"><i class="fa fa-eye"></i></a>
                        <form method="post" action="/yonetim/mesajlar/{{ m.id }}/okundu">
                            <input type="hidden" name="_csrf" value="{{ csrf }}">
                            <button class="adm-iconbtn" title="Okundu/okunmadı işaretle"><i class="fa fa-{{ m.is_read ? 'envelope' : 'envelope-open-o' }}"></i></button>
                        </form>
                        <form method="post" action="/yonetim/mesajlar/{{ m.id }}/sil" data-confirm="Mesaj silinsin mi?">
                            <input type="hidden" name="_csrf" value="{{ csrf }}">
                            <button class="adm-iconbtn adm-iconbtn--danger" title="Sil"><i class="fa fa-trash"></i></button>
                        </form>
                    </div>
                </td>
            </tr>
            {% else %}
            <tr><td colspan="7" class="adm-table__empty"><i class="fa fa-inbox" style="font-size:2rem;opacity:.3"></i><br>{{ search ? 'Aramanıza uygun mesaj bulunamadı.' : 'Henüz mesaj yok.' }}</td></tr>
            {% endfor %}
            </tbody>
        </table>
        </div>
    </div>
</div>
{% endblock %}
