{% extends 'admin/layout.twig' %}
{% set current_nav = 'pages' %}
{% block title %}{{ page ? 'Sayfa Düzenle' : 'Yeni Sayfa' }}{% endblock %}

{% block content %}
<div class="adm-pagehead">
    <div><h2>{{ page ? 'Sayfa Düzenle' : 'Yeni Sayfa' }}</h2></div>
    <a class="adm-btn" href="/yonetim/sayfalar"><i class="fa fa-arrow-left"></i> Listeye Dön</a>
</div>

<form class="adm-form" method="post" action="{{ action }}">
    <input type="hidden" name="_csrf" value="{{ csrf }}">
    <div class="adm-grid">
        <div class="adm-card"><div class="adm-card__body">
            <div class="adm-form">
                <div class="adm-field"><label>Başlık *</label><input type="text" name="title" value="{{ page.title|default('') }}" required></div>
                <div class="adm-field"><label>URL Slug</label><input type="text" name="slug" value="{{ page.slug|default('') }}" placeholder="hakkimizda"></div>
                <div class="adm-field"><label>İçerik <span class="hint">(HTML destekler)</span></label><textarea name="body" rows="16">{{ page.body|default('') }}</textarea></div>
            </div>
        </div></div>
        <div>
            <div class="adm-card">
                <div class="adm-card__head"><h3><i class="fa fa-line-chart"></i> SEO</h3></div>
                <div class="adm-card__body"><div class="adm-form">
                    <div class="adm-field"><label>Meta Başlık</label><input type="text" name="meta_title" value="{{ page.meta_title|default('') }}" data-count="60"></div>
                    <div class="adm-field"><label>Meta Açıklama</label><textarea name="meta_description" rows="3" data-count="160">{{ page.meta_description|default('') }}</textarea></div>
                    <label class="adm-check"><input type="checkbox" name="is_active" {{ page is null or page.is_active ? 'checked' }}> Aktif</label>
                </div></div>
            </div>
            <div class="adm-card"><div class="adm-card__body">
                <div class="adm-quick" style="flex-direction:column">
                    <button type="submit" class="adm-btn adm-btn--primary" style="justify-content:center"><i class="fa fa-check"></i> Kaydet</button>
                    <a href="/yonetim/sayfalar" class="adm-btn" style="justify-content:center">Vazgeç</a>
                </div>
            </div></div>
        </div>
    </div>
</form>
{% endblock %}

{% block scripts %}
<script>
document.querySelectorAll('[data-count]').forEach(function(el){
  var max = +el.dataset.count;
  var c = document.createElement('span'); c.className='adm-field__count';
  el.parentNode.appendChild(c);
  function upd(){ var n=el.value.length; c.textContent=n+' / '+max; c.className='adm-field__count '+(n>=Math.round(max*0.5)&&n<=max?'is-good':'is-bad'); }
  el.addEventListener('input',upd); upd();
});
</script>
{% endblock %}
