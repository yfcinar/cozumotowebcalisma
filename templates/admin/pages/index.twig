{% extends 'admin/layout.twig' %}
{% set current_nav = 'pages' %}
{% block title %}Sayfalar{% endblock %}

{% block content %}
<div class="adm-pagehead">
    <div><h2>Sayfalar</h2><p>Hakkımızda gibi serbest içerik sayfalarını yönetin.</p></div>
    <a class="adm-btn adm-btn--primary" href="/yonetim/sayfalar/yeni"><i class="fa fa-plus"></i> Yeni Sayfa</a>
</div>

<div class="adm-card">
    <div class="adm-card__body adm-card__body--pad0">
        <div class="adm-tablewrap">
        <table class="adm-table">
            <thead><tr><th>Başlık</th><th>URL</th><th>Durum</th><th></th></tr></thead>
            <tbody>
            {% for p in pages %}
            <tr>
                <td><strong>{{ p.title }}</strong></td>
                <td><span class="adm-mono adm-muted">{{ p.slug == 'hakkimizda' ? '/hakkimizda' : '/sayfa/' ~ p.slug }}</span></td>
                <td>{% if p.is_active %}<span class="adm-badge adm-badge--green">Aktif</span>{% else %}<span class="adm-badge adm-badge--gray">Pasif</span>{% endif %}</td>
                <td class="text-right">
                    <div class="adm-actions">
                        <a class="adm-iconbtn" href="/yonetim/sayfalar/{{ p.id }}/duzenle" title="Düzenle"><i class="fa fa-pencil"></i></a>
                        <form method="post" action="/yonetim/sayfalar/{{ p.id }}/sil" data-confirm="Bu sayfayı silmek istediğinize emin misiniz?">
                            <input type="hidden" name="_csrf" value="{{ csrf }}">
                            <button class="adm-iconbtn adm-iconbtn--danger" title="Sil"><i class="fa fa-trash"></i></button>
                        </form>
                    </div>
                </td>
            </tr>
            {% else %}
            <tr><td colspan="4" class="adm-table__empty"><i class="fa fa-file-text-o" style="font-size:2rem;opacity:.3"></i><br>Henüz sayfa eklenmemiş.</td></tr>
            {% endfor %}
            </tbody>
        </table>
        </div>
    </div>
</div>
{% endblock %}
