{% extends 'admin/layout.twig' %}
{% set current_nav = 'faqs' %}
{% block title %}{{ faq ? 'Soru Düzenle' : 'Yeni Soru' }}{% endblock %}

{% block content %}
<div class="adm-pagehead">
    <div><h2>{{ faq ? 'Soru Düzenle' : 'Yeni Soru' }}</h2></div>
    <a class="adm-btn" href="/yonetim/sss"><i class="fa fa-arrow-left"></i> Listeye Dön</a>
</div>

<div class="adm-card" style="max-width:720px">
    <div class="adm-card__body">
        <form class="adm-form" method="post" action="{{ action }}">
            <input type="hidden" name="_csrf" value="{{ csrf }}">
            <div class="adm-field">
                <label>Hizmet <span class="hint">(boş = genel S.S.S.)</span></label>
                <select name="service_id">
                    <option value="">Genel</option>
                    {% for s in services %}
                    <option value="{{ s.id }}" {{ faq and faq.service_id == s.id ? 'selected' }}>{{ s.title }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="adm-field"><label>Soru *</label><input type="text" name="question" value="{{ faq.question|default('') }}" required></div>
            <div class="adm-field"><label>Cevap *</label><textarea name="answer" rows="5" required>{{ faq.answer|default('') }}</textarea></div>
            <div class="adm-field"><label>Sıralama</label><input type="number" name="sort_order" value="{{ faq.sort_order|default(0) }}"></div>
            <label class="adm-check"><input type="checkbox" name="is_active" {{ faq is null or faq.is_active ? 'checked' }}> Aktif</label>
            <div class="adm-form__actions">
                <button type="submit" class="adm-btn adm-btn--primary"><i class="fa fa-check"></i> Kaydet</button>
                <a href="/yonetim/sss" class="adm-btn">Vazgeç</a>
            </div>
        </form>
    </div>
</div>
{% endblock %}
