{% extends 'admin/layout.twig' %}
{% set current_nav = 'districts' %}
{% block title %}{{ district ? 'İlçe Düzenle' : 'Yeni İlçe' }}{% endblock %}

{% block content %}
<div class="adm-pagehead">
    <div><h2>{{ district ? 'İlçe Düzenle' : 'Yeni İlçe' }}</h2></div>
    <a class="adm-btn" href="/yonetim/ilceler"><i class="fa fa-arrow-left"></i> Listeye Dön</a>
</div>

<div class="adm-card" style="max-width:560px">
    <div class="adm-card__body">
        <form class="adm-form" method="post" action="{{ action }}">
            <input type="hidden" name="_csrf" value="{{ csrf }}">
            <div class="adm-field">
                <label>İlçe Adı *</label>
                <input type="text" name="name" value="{{ district.name|default('') }}" required placeholder="Esenyurt">
            </div>
            <div class="adm-field">
                <label>URL Slug <span class="hint">(boş bırakılırsa addan üretilir)</span></label>
                <input type="text" name="slug" value="{{ district.slug|default('') }}" placeholder="esenyurt">
            </div>
            <div class="adm-field">
                <label>Sıralama</label>
                <input type="number" name="sort_order" value="{{ district.sort_order|default(0) }}">
            </div>
            <label class="adm-check"><input type="checkbox" name="is_active" {{ district is null or district.is_active ? 'checked' }}> Aktif</label>
            <div class="adm-form__actions">
                <button type="submit" class="adm-btn adm-btn--primary"><i class="fa fa-check"></i> Kaydet</button>
                <a href="/yonetim/ilceler" class="adm-btn">Vazgeç</a>
            </div>
        </form>
    </div>
</div>
{% endblock %}
