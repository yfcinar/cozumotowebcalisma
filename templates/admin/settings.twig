{% extends 'admin/layout.twig' %}
{% set current_nav = 'settings' %}
{% block title %}Site Ayarları{% endblock %}

{% set labels = {
    'brand_name': 'Marka Adı', 'site_title': 'Site Başlığı (SEO)', 'site_description': 'Site Açıklaması (SEO)',
    'phone_primary': 'Telefon (Birincil)', 'phone_secondary': 'Telefon (İkincil)', 'whatsapp': 'WhatsApp Numarası',
    'email': 'E-posta', 'address': 'Adres', 'maps_url': 'Google Maps Linki', 'maps_embed': 'Harita Embed Kodu (iframe)',
    'working_hours': 'Çalışma Saatleri',
    'instagram': 'Instagram', 'facebook': 'Facebook', 'twitter': 'X (Twitter)', 'youtube': 'YouTube',
    'linkedin': 'LinkedIn', 'pinterest': 'Pinterest',
    'hero_title': 'Anasayfa Başlık', 'hero_subtitle': 'Anasayfa Alt Başlık'
} %}
{% set groups = {
    'Genel & SEO': ['brand_name', 'site_title', 'site_description', 'hero_title', 'hero_subtitle'],
    'İletişim': ['phone_primary', 'phone_secondary', 'whatsapp', 'email', 'address', 'working_hours', 'maps_url', 'maps_embed'],
    'Sosyal Medya': ['instagram', 'facebook', 'twitter', 'youtube', 'linkedin', 'pinterest']
} %}
{% set longfields = ['site_description', 'address', 'maps_embed', 'hero_subtitle'] %}

{% block content %}
<div class="adm-pagehead">
    <div><h2>Site Ayarları</h2><p>İletişim bilgileri, sosyal medya ve anasayfa metinleri.</p></div>
</div>

<form class="adm-form" method="post" action="/yonetim/ayarlar" enctype="multipart/form-data">
    <input type="hidden" name="_csrf" value="{{ csrf }}">

    <div class="adm-card">
        <div class="adm-card__head"><h3><i class="fa fa-picture-o"></i> Logo</h3></div>
        <div class="adm-card__body">
            <div class="adm-form">
                <div class="adm-field">
                    <label>Mevcut logo</label>
                    {% if values.logo %}
                        <div style="background:#0b0e14;padding:.8rem 1rem;border-radius:10px;display:inline-block"><img src="/{{ values.logo }}" alt="Logo" style="height:48px;width:auto;max-width:240px;display:block"></div>
                        <label class="adm-check" style="margin-top:.6rem"><input type="checkbox" name="logo_remove" value="1"> Logoyu kaldır (varsayılan "RES" işaretine dön)</label>
                    {% else %}
                        <p style="margin:0;color:#66615b">Logo yüklenmedi, varsayılan "RES" işareti kullanılıyor.</p>
                    {% endif %}
                </div>
                <div class="adm-field">
                    <label>Yeni logo yükle</label>
                    <input type="file" name="logo_file" accept="image/png,image/jpeg,image/webp">
                    <small style="color:#66615b">PNG, JPG veya WEBP, en fazla 2 MB. Site üstte koyu zeminde açıldığı için açık renkli veya şeffaf zeminli PNG en iyi sonucu verir.</small>
                </div>
                <div class="adm-field">
                    <label class="adm-check"><input type="checkbox" name="logo_hide_text" value="1" {{ values.logo_hide_text == '1' ? 'checked' }}> Logonun yanındaki marka yazısını gizle (logo zaten isim içeriyorsa)</label>
                </div>
            </div>
        </div>
    </div>

    {% for group, gkeys in groups %}
    <div class="adm-card">
        <div class="adm-card__head"><h3><i class="fa fa-{{ group == 'İletişim' ? 'phone' : (group == 'Sosyal Medya' ? 'share-alt' : 'info-circle') }}"></i> {{ group }}</h3></div>
        <div class="adm-card__body">
            <div class="adm-form">
                {% for key in gkeys %}
                {% if key in keys %}
                <div class="adm-field">
                    <label>{{ labels[key]|default(key) }}</label>
                    {% if key in longfields %}
                        <textarea name="{{ key }}" rows="3">{{ values[key]|default('') }}</textarea>
                    {% else %}
                        <input type="text" name="{{ key }}" value="{{ values[key]|default('') }}">
                    {% endif %}
                </div>
                {% endif %}
                {% endfor %}
            </div>
        </div>
    </div>
    {% endfor %}
    <div class="adm-form__actions" style="border:0">
        <button type="submit" class="adm-btn adm-btn--primary"><i class="fa fa-check"></i> Ayarları Kaydet</button>
    </div>
</form>
{% endblock %}
