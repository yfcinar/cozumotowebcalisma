<footer class="footer footer-black footer-big">
    <div class="container">
        <div class="row">
            <div class="col-md-4 mb-4 mb-md-0">
                <div class="brand brand--footer mb-3">
                    <span class="brand__mark">RES</span>
                    <span class="brand__text">
                        <strong>{{ site.brand_name|default('Çözüm Oto Elektrik') }}</strong>
                        <small>Renault Elektronik Servisi</small>
                    </span>
                </div>
                <p class="footer__about">{{ site.site_description|default('Renault EDC şanzıman, beyin onarımı, kavrama ve oto elektronik arızalarında garantili, aynı gün teslim hizmet.') }}</p>
                <div class="footer__social">
                    {% if site.instagram %}<a href="{{ site.instagram }}" target="_blank" rel="noopener" class="btn btn-neutral btn-just-icon btn-round" aria-label="Instagram"><i class="fa fa-instagram"></i></a>{% endif %}
                    {% if site.facebook %}<a href="{{ site.facebook }}" target="_blank" rel="noopener" class="btn btn-neutral btn-just-icon btn-round" aria-label="Facebook"><i class="fa fa-facebook"></i></a>{% endif %}
                    {% if site.youtube %}<a href="{{ site.youtube }}" target="_blank" rel="noopener" class="btn btn-neutral btn-just-icon btn-round" aria-label="YouTube"><i class="fa fa-youtube-play"></i></a>{% endif %}
                    {% if site.whatsapp %}<a href="{{ whatsapp_link() }}" target="_blank" rel="noopener" class="btn btn-neutral btn-just-icon btn-round" aria-label="WhatsApp"><i class="fa fa-whatsapp"></i></a>{% endif %}
                </div>
            </div>

            <div class="col-md-4 mb-4 mb-md-0">
                <h5 class="footer__title">Hizmetler</h5>
                <ul class="footer__links">
                    {% for s in menu_services|slice(0, 8) %}
                        <li><a href="/hizmet/{{ s.slug }}">{{ s.title }}</a></li>
                    {% endfor %}
                </ul>
            </div>

            <div class="col-md-4">
                <h5 class="footer__title">İletişim</h5>
                <ul class="footer__links footer__contact">
                    {% if site.address %}<li><i class="fa fa-map-marker"></i> {{ site.address }}</li>{% endif %}
                    {% if site.phone_primary %}<li><i class="fa fa-phone"></i> <a href="{{ tel_link(site.phone_primary) }}">{{ site.phone_primary }}</a></li>{% endif %}
                    {% if site.phone_secondary %}<li><i class="fa fa-phone"></i> <a href="{{ tel_link(site.phone_secondary) }}">{{ site.phone_secondary }}</a></li>{% endif %}
                    {% if site.email %}<li><i class="fa fa-envelope-o"></i> <a href="mailto:{{ site.email }}">{{ site.email }}</a></li>{% endif %}
                    {% if site.working_hours %}<li><i class="fa fa-clock-o"></i> {{ site.working_hours }}</li>{% endif %}
                </ul>
            </div>
        </div>

        <hr class="footer__hr">
        <div class="d-flex justify-content-between flex-wrap footer__bottom">
            <span>© {{ app.year }} {{ site.brand_name|default('Çözüm Oto Elektrik') }}. Tüm hakları saklıdır.</span>
            <a href="/yonetim/giris" class="footer__admin">Yönetim</a>
        </div>
    </div>
</footer>
