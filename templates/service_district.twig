{% extends 'layout.twig' %}
{% block title %}{{ meta_title }}{% endblock %}
{% block description %}{{ meta_desc }}{% endblock %}

{% block head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "{{ heading }}",
  "areaServed": "{{ district.name }}, İstanbul",
  "provider": {
    "@type": "AutoRepair",
    "name": "{{ site.brand_name|default('Çözüm Oto Elektrik') }}",
    "telephone": "{{ site.phone_primary }}",
    "address": "{{ site.address }}"
  }
}
</script>
{% endblock %}

{% block content %}
<div class="page-header page-head" style="background-image: url('/assets/img/head-tools.jpg');">
    <div class="filter"></div>
    <div class="container">
        <div class="motto">
            <nav class="breadcrumb-line"><a href="/">Anasayfa</a> <i class="fa fa-angle-right"></i> <a href="/hizmetler">Hizmetler</a> <i class="fa fa-angle-right"></i> <a href="/hizmet/{{ service.slug }}">{{ service.title }}</a> <i class="fa fa-angle-right"></i> <span>{{ district.name }}</span></nav>
            <h1>{{ heading }}</h1>
        </div>
    </div>
</div>

<div class="section">
    <div class="container">
        <div class="row">
            <div class="col-lg-8">
                <div class="card card-prose"><div class="card-body prose">{{ body|raw }}</div></div>

                <div class="content__cta">
                    {% if site.whatsapp %}<a class="btn btn-success btn-round" href="{{ whatsapp_link('Merhaba, ' ~ heading ~ ' için bilgi almak istiyorum.') }}" target="_blank" rel="noopener"><i class="fa fa-whatsapp"></i> WhatsApp'tan Sor</a>{% endif %}
                    {% if site.phone_primary %}<a class="btn btn-outline-danger btn-round" href="{{ tel_link(site.phone_primary) }}"><i class="fa fa-phone"></i> {{ site.phone_primary }}</a>{% endif %}
                </div>

                {% if faqs|length %}
                <div class="faq-acc mt-4" id="faq-accordion" role="tablist">
                    <h2 class="title">Sıkça Sorulan Sorular</h2>
                    {% for f in faqs %}
                    <div class="card card-faq">
                        <div class="card-header" role="tab" id="faq-h{{ loop.index }}">
                            <a data-toggle="collapse" href="#faq-c{{ loop.index }}" role="button"
                               aria-expanded="false" aria-controls="faq-c{{ loop.index }}" class="collapsed">
                                {{ f.question }}
                                <i class="fa fa-angle-down"></i>
                            </a>
                        </div>
                        <div id="faq-c{{ loop.index }}" class="collapse" role="tabpanel"
                             aria-labelledby="faq-h{{ loop.index }}" data-parent="#faq-accordion">
                            <div class="card-body">{{ f.answer|nl2br }}</div>
                        </div>
                    </div>
                    {% endfor %}
                </div>
                {% endif %}
            </div>

            <div class="col-lg-4">
                <aside class="sidebar">
                    <div class="card sidebar__box">
                        <div class="card-body">
                            <h3 class="card-title">Diğer Bölgeler</h3>
                            <ul class="district-list list-unstyled">
                                {% for d in districts %}
                                <li{% if d.id == district.id %} class="is-active"{% endif %}>
                                    <a href="/hizmet/{{ service.slug }}/{{ d.slug }}">{{ d.name }}</a>
                                </li>
                                {% endfor %}
                            </ul>
                        </div>
                    </div>
                    <div class="card sidebar__box sidebar__box--accent">
                        <div class="card-body">
                            <h3 class="card-title">Hızlı İletişim</h3>
                            {% if site.phone_primary %}<a class="sidebar__phone" href="{{ tel_link(site.phone_primary) }}">{{ site.phone_primary }}</a>{% endif %}
                            {% if site.address %}<p>{{ site.address }}</p>{% endif %}
                        </div>
                    </div>
                </aside>
            </div>
        </div>
    </div>
</div>
{% endblock %}
